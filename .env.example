# Copy to .env.local and fill in. Never commit .env.local.

DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/mycommerce?sslmode=require"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

RESEND_API_KEY=""
EMAIL_FROM="MyCommerce <noreply@example.com>"
CRON_SECRET=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
STORE_CONTACT_EMAIL=""
STORE_CONTACT_PHONE=""

# Meta analytics environment fallback. Existing stores can keep using these;
# Admin → Integrations → Meta can override them at runtime without a redeploy.
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_DATASET_ID=""
META_CAPI_ACCESS_TOKEN=""
META_CAPI_TEST_EVENT_CODE=""
META_GRAPH_API_VERSION="v25.0"

# Optional dedicated key for encrypted integration credentials. If omitted, a
# purpose-specific encryption key is derived from BETTER_AUTH_SECRET.
# INTEGRATION_ENCRYPTION_KEY="generate-at-least-32-random-characters"

# SSLCommerz
# SSLCOMMERZ_STORE_ID=""
# SSLCOMMERZ_STORE_PASSWORD=""
# SSLCOMMERZ_SANDBOX="true"

# Bank transfer details
# BANK_ACCOUNT_NAME=""
# BANK_ACCOUNT_NUMBER=""
# BANK_NAME=""
# BANK_BRANCH=""
