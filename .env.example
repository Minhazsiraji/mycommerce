# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres — pooled connection string from the Neon dashboard
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/mycommerce?sslmode=require"
# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Store identity. Every deployment sets its own, including the original store —
# there is no built-in business identity to inherit.
# STORE_NAME and STORE_CANONICAL_URL are REQUIRED in production; a production
# deployment without them fails to build rather than serving a placeholder
# canonical URL into your sitemap and Merchant feed.
# STORE_BRAND_ACCENT is the differently-coloured tail of the wordmark, if any:
# brand text "Acme" + accent "Shop" renders as AcmeShop.
STORE_NAME="Example Store"
STORE_BRAND_TEXT="Example"
STORE_BRAND_ACCENT="Store"
STORE_CANONICAL_URL="https://example.com"
STORE_COUNTRY_NAME="Bangladesh"
STORE_LOCALE="en-BD"
STORE_DEFAULT_DESCRIPTION=""

# Country and currency MUST use the NEXT_PUBLIC_ prefix. The browser renders
# prices too, and Next only inlines NEXT_PUBLIC_* into client bundles — setting
# the bare STORE_CURRENCY would give you a server that says USD and a
# storefront that still shows the default. Setting the bare name without the
# public one is refused at startup rather than allowed to split.
NEXT_PUBLIC_STORE_COUNTRY_CODE="BD"
NEXT_PUBLIC_STORE_CURRENCY="BDT"
# Both derived from the currency when omitted: the symbol from a built-in table
# (falling back to the ISO code), the decimals from the currency (0 for
# JPY/KRW/VND, otherwise 2). Symbols render as a prefix.
NEXT_PUBLIC_STORE_CURRENCY_SYMBOL=""
NEXT_PUBLIC_STORE_CURRENCY_MINOR_UNITS=""
# Digit grouping only. Left at en-US because en-BD and en-IN group in
# lakh/crore ("12,34,567"), which is not what this storefront has ever shown.
NEXT_PUBLIC_STORE_NUMBER_LOCALE="en-US"
# Tax. Defaults to "none", which is exactly how the store behaved before this
# setting existed: total = subtotal + delivery, no tax line, tax_amount 0.
#   none      prices are what they are; nothing is disclosed or added
#   inclusive prices already contain tax; the total does not change, the
#             contained amount is disclosed and recorded on the order
#   exclusive tax is calculated and ADDED at checkout
# Rate is whole basis points: 750 = 7.5%. Order of operations is
# subtotal -> less discount -> plus delivery -> tax -> total.
# This is configuration, not tax compliance: one rate, no jurisdiction lookup,
# no product tax categories. You remain responsible for your local obligations.
NEXT_PUBLIC_STORE_TAX_MODE="none"
NEXT_PUBLIC_STORE_TAX_RATE_BASIS_POINTS="0"
NEXT_PUBLIC_STORE_TAX_LABEL="VAT"
NEXT_PUBLIC_STORE_TAX_ON_SHIPPING="false"

# Confirms a human reviewed Terms, Privacy and Returns against this business and
# its jurisdiction. Required in production — the bundled policy text is a
# template written for a different store, and no script can tell whether it is
# true of yours. Edit the pages in Admin → Content → Policy pages first.
STORE_POLICIES_REVIEWED="false"

# Set to "false" to remove cash on delivery. A store must keep at least one
# payment method available; `pnpm preflight` fails if none is.
STORE_COD_ENABLED="true"

# NEXT_PUBLIC_STORE_COUNTRY_CODE also selects the checkout address model:
# "BD" gives the district/city/thana cascade and +880 phone validation,
# anything else gives a generic address with an optional region and a required
# postal code. See docs/CLONE_READINESS.md.

# Resend — transactional email
RESEND_API_KEY=""
EMAIL_FROM="MyCommerce <noreply@example.com>"

# Cron route authorization — generate with: openssl rand -base64 32
CRON_SECRET=""

# Cloudinary — product image storage and delivery
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Public customer/business contact details. Keep these consistent with Merchant Center.
STORE_CONTACT_EMAIL=""
STORE_ADMIN_EMAIL=""
STORE_CONTACT_PHONE=""
STORE_BUSINESS_ADDRESS=""

# Meta environment fallback. Admin-managed values take precedence after setup.
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_DATASET_ID=""
META_CAPI_ACCESS_TOKEN=""
META_CAPI_TEST_EVENT_CODE=""
META_GRAPH_API_VERSION="v25.0"

# Google tag environment fallback. Admin → Integrations → Google takes precedence
# after setup. Every client clone must use its own Google tag ID.
NEXT_PUBLIC_GOOGLE_TAG_ID=""

# Encrypts admin-managed integration secrets stored in Postgres.
# Generate a 32-byte Base64 key, e.g. `openssl rand -base64 32`.
# Server-only: never expose this as NEXT_PUBLIC_*.
INTEGRATIONS_ENCRYPTION_KEY=""

# SSLCommerz
# SSLCOMMERZ_STORE_ID=""
# SSLCOMMERZ_STORE_PASSWORD=""
# SSLCOMMERZ_SANDBOX="true"

# Bank transfer details
# BANK_ACCOUNT_NAME=""
# BANK_ACCOUNT_NUMBER=""
# BANK_NAME=""
# BANK_BRANCH=""
