# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres — pooled connection string from the Neon dashboard
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/mycommerce?sslmode=require"
# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Store identity / white-label defaults.
# SirajiBD remains the built-in default when these are omitted.
STORE_NAME="SirajiBD"
STORE_BRAND_TEXT="Siraji"
STORE_BRAND_ACCENT="BD"
STORE_CANONICAL_URL="https://sirajibd.com"
STORE_COUNTRY_CODE="BD"
STORE_COUNTRY_NAME="Bangladesh"
STORE_CURRENCY="BDT"
STORE_LOCALE="en-BD"
STORE_DEFAULT_DESCRIPTION=""

# Resend — transactional email
RESEND_API_KEY=""
EMAIL_FROM="MyCommerce <noreply@example.com>"

# Cron route authorization — generate with: openssl rand -base64 32
CRON_SECRET=""

# Cloudinary — product image storage and delivery
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Public customer/business contact details. Keep these consistent with Merchant Center.
STORE_CONTACT_EMAIL=""
STORE_ADMIN_EMAIL=""
STORE_CONTACT_PHONE=""
STORE_BUSINESS_ADDRESS=""

# Meta environment fallback. Admin-managed values take precedence after setup.
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_DATASET_ID=""
META_CAPI_ACCESS_TOKEN=""
META_CAPI_TEST_EVENT_CODE=""
META_GRAPH_API_VERSION="v25.0"

# Google tag environment fallback. Admin → Integrations → Google takes precedence
# after setup. Every client clone must use its own Google tag ID.
NEXT_PUBLIC_GOOGLE_TAG_ID=""

# Encrypts admin-managed integration secrets stored in Postgres.
# Generate a 32-byte Base64 key, e.g. `openssl rand -base64 32`.
# Server-only: never expose this as NEXT_PUBLIC_*.
INTEGRATIONS_ENCRYPTION_KEY=""

# SSLCommerz
# SSLCOMMERZ_STORE_ID=""
# SSLCOMMERZ_STORE_PASSWORD=""
# SSLCOMMERZ_SANDBOX="true"

# Bank transfer details
# BANK_ACCOUNT_NAME=""
# BANK_ACCOUNT_NUMBER=""
# BANK_NAME=""
# BANK_BRANCH=""
