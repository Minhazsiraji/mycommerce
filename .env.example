# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres — pooled connection string from the Neon dashboard
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/mycommerce?sslmode=require"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend — transactional email
RESEND_API_KEY=""
EMAIL_FROM="MyCommerce <noreply@example.com>"

# Cron route authorization — generate with: openssl rand -base64 32
CRON_SECRET=""

# Cloudinary — product image storage and delivery
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# How customers reach a human. Shown in the footer; each line is omitted when
# unset, so the footer never advertises a channel nobody is watching.
STORE_CONTACT_EMAIL=""
STORE_CONTACT_PHONE=""

# --- Added in later phases ---
# SSLCommerz (P2)
# SSLCOMMERZ_STORE_ID=""
# SSLCOMMERZ_STORE_PASSWORD=""
# SSLCOMMERZ_SANDBOX="true"

# Bank transfer details shown to customers (P2)
# BANK_ACCOUNT_NAME=""
# BANK_ACCOUNT_NUMBER=""
# BANK_NAME=""
# BANK_BRANCH=""
